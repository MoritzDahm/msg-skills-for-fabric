{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "msg-powerbi-standards",
  "description": "Built by msg: a complete, self-sufficient Power BI toolkit for Microsoft's skills-for-fabric — semantic model authoring, report planning/design/authoring/management, Fabric publishing, msg's governance rules, and msg's corporate design standards (colors, fonts, theme, layout policy), with a blank template for organizations that want their own brand instead of msg's.",
  "version": "0.2.0",
  "license": "MIT",
  "author": {
    "name": "msg",
    "url": "REPLACE_WITH_MSG_URL"
  },
  "repository": "REPLACE_WITH_MSG_REPO_URL",
  "keywords": [
    "msg",
    "powerbi",
    "fabric",
    "design-system",
    "brand",
    "theme",
    "corporate-standards",
    "semantic-model",
    "pbip",
    "pbir",
    "skills-for-fabric"
  ],
  "skills": [
    "./skills/check-updates",
    "./skills/semantic-model-authoring",
    "./skills/powerbi-report-planning",
    "./skills/powerbi-report-design",
    "./skills/powerbi-report-authoring",
    "./skills/powerbi-report-management",
    "./skills/powerbi-dashboard-architect",
    "./skills/company-powerbi-standards"
  ],
  "agents": [],
  "mcpServers": {
    "powerbi-modeling-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/powerbi-modeling-mcp@latest",
        "--start"
      ]
    }
  }
}
